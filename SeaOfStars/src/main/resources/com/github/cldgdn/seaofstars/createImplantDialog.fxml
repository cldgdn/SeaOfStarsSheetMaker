                  <Label text="Costo Umano " />
                  <ComboBox fx:id="costValueCombo" />
               </children>
            </HBox>
            <VBox fx:id="bonusesVbox" spacing="10.0" />
            <Button fx:id="traitBonusButton" mnemonicParsing="false" onAction="#addBonus" text="Aggiungi Bonus Tratto" />
            <Button fx:id="abilityBonusButton" layoutX="20.0" layoutY="313.0" mnemonicParsing="false" onAction="#addBonus" text="Aggiungi Bonus Abilità" />
            <Button fx:id="otherBonusButton" layoutX="20.0" layoutY="348.0" mnemonicParsing="false" onAction="#addBonus" text="Aggiungi Bonus per Altro" />
         </children>
