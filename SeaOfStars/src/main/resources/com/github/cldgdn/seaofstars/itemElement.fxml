<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="50.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cldgdn.seaofstars.controller.ItemElementController">
   <children>
      <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="5.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="nameLabel" text="Name" />
                  <Label fx:id="amtLabel" text="Cost/Passive" />
                  <Button fx:id="addButton" alignment="CENTER" contentDisplay="CENTER" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" mnemonicParsing="false" onAction="#changeItemAmount" prefHeight="25.0" prefWidth="25.0" text="+" />
                  <Button fx:id="remButton" alignment="CENTER" contentDisplay="CENTER" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" mnemonicParsing="false" onAction="#changeItemAmount" prefHeight="25.0" prefWidth="25.0" text="-" />
               </children>
            </HBox>
            <TitledPane expanded="false" text="Descrizione" VBox.vgrow="NEVER">
               <content>
                  <AnchorPane maxHeight="300.0" maxWidth="300.0" minHeight="0.0" minWidth="0.0" prefHeight="200.0">
                     <children>
                        <TextArea fx:id="descriptionArea" onKeyTyped="#updateDescription" prefHeight="200.0" prefWidth="400.0" text="ai sygfvk usn sng vmso drgm  svogmsdb" wrapText="true" AnchorPane.bottomAnchor="-10.0" AnchorPane.leftAnchor="-10.0" AnchorPane.rightAnchor="-10.0" AnchorPane.topAnchor="-10.0" />
                     </children>
