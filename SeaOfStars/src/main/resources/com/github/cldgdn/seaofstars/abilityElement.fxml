<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>


<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cldgdn.seaofstars.controller.AbilityElementController">
   <padding>
      <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
   </padding>
   <children>
      <Label fx:id="nameLabel" text="name">
         <tooltip>
            <Tooltip fx:id="nameTooltip" text="Empty Tooltip" />
         </tooltip>
      </Label>
      <GridPane alignment="CENTER" hgap="5.0" vgap="5.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <RadioButton fx:id="lv1Button" mnemonicParsing="false" onAction="#updateLevel" />
            <RadioButton fx:id="lv2Button" layoutX="36.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="1" />
            <RadioButton fx:id="lv3Button" layoutX="36.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="2" />
            <RadioButton fx:id="lv4Button" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="3" />
            <RadioButton fx:id="lv5Button" layoutX="84.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="4" />
            <RadioButton fx:id="lv6Button" disable="true" mnemonicParsing="false" onAction="#updateLevel" GridPane.rowIndex="1" />
            <RadioButton fx:id="lv7Button" disable="true" layoutX="10.0" layoutY="33.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <RadioButton fx:id="lv8Button" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <RadioButton fx:id="lv9Button" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <RadioButton fx:id="lv10Button" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#updateLevel" GridPane.columnIndex="4" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <Label fx:id="levelLabel" text="Level" />
   </children>
