<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cldgdn.seaofstars.controller.RollWithIncrementsController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Tratto:" />
            <ComboBox fx:id="traitCombo" onAction="#updateTraitBonuses" prefWidth="150.0" promptText="Seleziona Tratto" />
            <Label text="Abilità:" />
            <ComboBox fx:id="abilityCombo" onAction="#updateAbilityBonuses" prefWidth="150.0" promptText="Selezioba Abilità" />
            <Button mnemonicParsing="false" onAction="#callRoll" text="Roll" />
         </children>
      </HBox>
      <Label fx:id="rollResultLabel" wrapText="true" />
      <Separator>
         <VBox.margin>
            <Insets left="-10.0" right="-10.0" />
         </VBox.margin>
      </Separator>
      <VBox fx:id="activeTraitBonusesVBox" />
      <Separator layoutX="10.0" layoutY="55.0">
         <VBox.margin>
            <Insets left="-10.0" right="-10.0" />
         </VBox.margin>
      </Separator>
      <VBox fx:id="activeAbilityBonusesVBox" layoutX="20.0" layoutY="69.0" />
   </children>
</VBox>
